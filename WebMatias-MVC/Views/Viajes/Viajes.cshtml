@{
}

@model List<Viajes>



    

@{
    //aca  se puede escribir el comentario
}


<div class="viajes-container">

    <div class="viajes-titulo">
        <h1>Buscá tu próximo viaje</h1>
        <p>Ingresá tu origen y destino para consultar los servicios disponibles.</p>
    </div>

    <div class="buscador-viajes">

        <form asp-action="Viajes" method="get" asp-fragment="resultados">

            <div class="campo-viaje">
                <label>Origen</label>
                <input type="text"
                       id="origen"
                       class="form-control"
                       name="Origen"
                       list="listaOrigen"
                       placeholder="¿Desde dónde viajás?" />
            </div>

            <datalist id="listaOrigen">

                @if (Model != null)
                {
                    foreach (var item in Model.Select(o=>o.Origen).Distinct())
                    {
                        <option value="@item"></option>
                    }
                }

                      



                


            </datalist>

            <div class="campo-viaje">
                <label>Destino</label>
                <input type="text"
                       id="destino"
                       class="form-control"
                       name="Destino"
                       list="listaDestino"
                       placeholder="¿Hacia dónde viajás?" />
            </div>

            <datalist id="listaDestino">

                    @if(Model != null)
                    {
                        @foreach (var item in Model.Select(d => d.Destino).Distinct())
                        {
                            <option value="@item"></option>
                        }



                    }




            </datalist>

            <button type="submit" class="btn-buscar">
                Buscar viaje
            </button>

        </form>

    </div>

                @if(Model!=null && Model.Count == 0)
                {
                  <label>No se encontraron viajes</label>


                }
             

    @if (Model != null && Model.Count > 0)
    {

         
        <div id="resultados" class="resultados-viajes">

            <h2>Viajes disponibles</h2>

         


            @foreach (var item in Model)
            {

                <div class="viaje-card">

                    <div class="viaje-empresa">
                        <img src="@Url.Content(item.UrlImagen)"
                             alt="Logo de la empresa"
                             class="logo-empresa" />
                    </div>

                    <div class="viaje-dato">
                        <span class="viaje-label">ORIGEN</span>
                        <span class="viaje-valor">@item.Origen</span>
                    </div>

                    <div class="flecha">
                        →
                    </div>

                    <div class="viaje-dato">
                        <span class="viaje-label">DESTINO</span>
                        <span class="viaje-valor">@item.Destino</span>
                    </div>

                    <div class="viaje-horario">
                        <span class="viaje-label">HORARIO</span>
                        <span class="horario">
                            @item.HorarioSalida
                        </span>
                    </div>

                    <div class="viaje-servicio">

                        <span class="viaje-label">Sericio</span>
                        <span class="servicio">@item.Servicio</span>

                    </div>

                    <div class="viaje-servicio">
                        <span class="viaje-label">Precio</span>
                        <span class="precio">@item.Precio</span>

                    </div>

                    <br />
                    <br />

              


                 

                </div>

              
               

            }

            <button type="button" class="btn btn-primary" onclick="limpiar()">

                Limpiar

            </button>
        </div>



    }

  

    <br />
    <br />

    <p style="color: lightpink">
        Para Enterarte Sobre Nuestras Promociones,Dale Click Al enlace(Interaccion personalizada):<a href="https://wa.me/5491133153864?text=Hola%20quiero%20consultar%20por%20clases" class=" text-light" target="_blank">
        1133153864
    </a>
</p>
</div>


<script>
    function limpiar() {
        document.getElementById("resultados").innerHTML = "";

        document.getElementById("origen").value = "";
        document.getElementById("destino").value = "";
    }
</script>


