@{
}

@model List<Viajes>



    

@{
    //aca  se puede escribir el comentario
}


<div class="viajes-container">

    <div class="viajes-titulo">
        <h1>Buscá tu próximo viaje</h1>
        <p>Ingresá tu origen y destino para consultar los servicios disponibles.</p>
    </div>

    <div class="buscador-viajes">

        <form asp-action="Viajes" method="get">

            <div class="campo-viaje">
                <label>Origen</label>
                <input type="text"
                       class="form-control"
                       name="Origen"
                       placeholder="¿Desde dónde viajás?" />
            </div>

            <div class="campo-viaje">
                <label>Destino</label>
                <input type="text"
                       class="form-control"
                       name="Destino"
                       placeholder="¿A dónde querés ir?" />
            </div>

            <button type="submit" class="btn-buscar">
                Buscar viaje
            </button>

        </form>

    </div>


    @if (Model != null && Model.Count > 0)
    {
        <div class="resultados-viajes">

            <h2>Viajes disponibles</h2>

            @foreach (var item in Model)
            {
                <div class="viaje-card">

                    <div class="viaje-dato">
                        <span class="viaje-label">ORIGEN</span>
                        <span class="viaje-valor">@item.Origen</span>
                    </div>

                    <div class="flecha">
                        →
                    </div>

                    <div class="viaje-dato">
                        <span class="viaje-label">DESTINO</span>
                        <span class="viaje-valor">@item.Destino</span>
                    </div>

                    <div class="viaje-horario">
                        <span class="viaje-label">HORARIO</span>
                        <span class="horario">
                            @item.HorarioSalida
                        </span>
                    </div>

                </div>
            }

        </div>
    }

</div>