@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model Giro

<h1>  Pagina Giro  </h1>

<br />
<br />
<br />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}





<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10">

            <div class="card bg-dark text-light shadow-lg border-secondary rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold">
                            Realizar Giro
                        </h2>

                        <p class="text-secondary mb-0">
                            Complete los datos para calcular y generar su giro.
                        </p>

                    </div>

                    <form asp-action="CrearGiro" method="post" id="formGiro">

                        <input type="hidden"
                               name="cotizacionMostrada"
                               value="@ViewBag.Cotizacion" />

                        <div class="row g-4">

                            <!-- REMITENTE -->

                            <div class="col-12">

                                <h5 class="border-bottom border-secondary pb-2">
                                    Datos del Remitente
                                </h5>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="NombreRemitente"
                                       class="form-label fw-semibold">
                                    Nombre y Apellido
                                </label>

                                <input asp-for="NombreRemitente"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Nombre y apellido" />

                                <span asp-validation-for="NombreRemitente"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="DniRemitente"
                                       class="form-label fw-semibold">
                                    DNI
                                </label>

                                <input asp-for="DniRemitente"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Número de DNI" />

                                <span asp-validation-for="DniRemitente"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="TelefonoRemitente"
                                       class="form-label fw-semibold">
                                    Teléfono
                                </label>

                                <input asp-for="TelefonoRemitente"
                                       type="tel"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Número de teléfono" />

                                <span asp-validation-for="TelefonoRemitente"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="EmailRemitente"
                                       class="form-label fw-semibold">
                                    Correo electrónico
                                </label>

                                <input asp-for="EmailRemitente"
                                       type="email"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="ejemplo@gmail.com" />

                                <div class="form-text text-secondary">
                                    Enviaremos la confirmación del giro a este correo.
                                </div>

                                <span asp-validation-for="EmailRemitente"
                                      class="text-danger small"></span>

                            </div>


                            <!-- DESTINATARIO -->

                            <div class="col-12 mt-5">

                                <h5 class="border-bottom border-secondary pb-2">
                                    Datos del Destinatario
                                </h5>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="NombreRecibe"
                                       class="form-label fw-semibold">
                                    Nombre y Apellido
                                </label>

                                <input asp-for="NombreRecibe"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Nombre del destinatario" />

                                <span asp-validation-for="NombreRecibe"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CedulaRecibe"
                                       class="form-label fw-semibold">
                                    Cédula
                                </label>

                                <input asp-for="CedulaRecibe"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Número de cédula" />

                                <span asp-validation-for="CedulaRecibe"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="TelefonoRecibe"
                                       class="form-label fw-semibold">
                                    Teléfono
                                </label>

                                <input asp-for="TelefonoRecibe"
                                       type="tel"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="Número del destinatario" />

                                <span asp-validation-for="TelefonoRecibe"
                                      class="text-danger small"></span>

                            </div>


                            <!-- GIRO -->

                            <div class="col-12 mt-5">

                                <h5 class="border-bottom border-secondary pb-2">
                                    Datos del Giro
                                </h5>

                            </div>

                            <div class="col-12">

                                <label asp-for="TipoGiroId"
                                       class="form-label fw-semibold">
                                    Tipo de Giro
                                </label>

                                

                                <select asp-for="TipoGiroId"
                                        class="form-select form-select-lg bg-black text-light border-secondary">

                                    <option value="">
                                        Seleccione el tipo de giro
                                    </option>

                                    @foreach (var item in ViewBag.TipoGiro)
                                    {
                                        <option value="@item.TipoGiroId">
                                            @item.TipoGiroNombre
                                        </option>
                                    }

                                            
                                         
                                </select>
                                <br />

                                <div id="campoAlias" hidden>
                                    <label asp-for="AliasRecibe">Ingrese el alias</label>
                                    <input asp-for="AliasRecibe" class="form-control" />
                                    <span asp-validation-for="AliasRecibe" class="text-danger"></span>
                                </div>
                                <br />
                                <br />


                                <div class="form-text text-secondary">
                                    Verifique cuidadosamente la moneda de origen y destino.
                                </div>

                                <span asp-validation-for="TipoGiroId"
                                      class="text-danger small"></span>

                            </div>


                            <!-- MONTOS -->

                            <div class="col-md-6">

                                <label asp-for="MontoEnvio"
                                       class="form-label fw-semibold">
                                    Monto a Enviar
                                </label>

                                <div class="input-group input-group-lg">

                                    <span class="input-group-text bg-secondary text-light border-secondary">
                                        $
                                    </span>

                                    <input asp-for="MontoEnvio"
                                           class="form-control bg-black text-light border-secondary"
                                           placeholder="0,00" />

                                </div>

                                <span asp-validation-for="MontoEnvio"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="MontoMonedaExtranjera"
                                       class="form-label fw-semibold">
                                    Recibe el Destinatario
                                </label>

                                <input asp-for="MontoMonedaExtranjera"
                                       class="form-control form-control-lg bg-black text-light border-secondary"
                                       placeholder="0,00"
                                       readonly />

                                <span asp-validation-for="MontoMonedaExtranjera"
                                      class="text-danger small"></span>

                            </div>


                            <!-- TOTAL -->

                            <div class="col-12">

                                <div class="p-4 rounded-3 border border-secondary bg-black">

                                    <label asp-for="MontoTotal"
                                           class="form-label fw-bold fs-5">
                                        Monto Final a Pagar
                                    </label>

                                    <div class="input-group input-group-lg">

                                        <span class="input-group-text bg-secondary text-light border-secondary">
                                            $
                                        </span>

                                        <input asp-for="MontoTotal"
                                               class="form-control bg-dark text-light border-secondary fw-bold"
                                               placeholder="0,00"
                                               readonly />

                                    </div>

                                    <span asp-validation-for="MontoTotal"
                                          class="text-danger small"></span>

                                </div>

                            </div>


                            <!-- BOTÓN -->

                            <div class="col-12 mt-4">

                                <button type="submit" id="btnGuardar"
                                        class="btn btn-danger btn-lg w-100 fw-bold rounded-3">

                                    Hacer el Giro

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
<br />
<br />

<div class="mb-3">
    <label class="form-label">
        Cotización actual
    </label>

    <input id="cambio" class="form-control"
           value="@ViewBag.Cotizacion"
           readonly />
</div>

<script>
    const montoEnvio = document.getElementById("MontoEnvio");
    const montoTotal = document.getElementById("MontoTotal");
    const montoCambio = document.getElementById("cambio");
    const montoMonedaExtranjera =
        document.getElementById("MontoMonedaExtranjera");

    montoEnvio.addEventListener("input", function() {
        const monto = parseFloat(montoEnvio.value) || 0;
        const cambio = parseFloat(montoCambio.value) || 0;

        const total = monto * 1.10;
        const totalCambio = monto * cambio;

        montoTotal.value = total.toFixed(2);
        montoMonedaExtranjera.value = totalCambio.toFixed(2);
    });
</script>

<script>
    const tipoGiro = document.getElementById("TipoGiroId");
    const campoAlias = document.getElementById("campoAlias");

    function mostrarAlias() {
        const opcion = tipoGiro.options[tipoGiro.selectedIndex];
        const nombre = opcion ? opcion.text.trim() : "";

        campoAlias.hidden = nombre !== "UENO BANK";
    }

    tipoGiro.addEventListener("change", mostrarAlias);

    mostrarAlias();
</script>

<script>
    const formulario = document.getElementById("formGiro");
    const boton = document.getElementById("btnGuardar");

    formulario.addEventListener("submit", function(evento) {

        // Si ya se está enviando, frena otro envío.
        if (boton.disabled) {
            evento.preventDefault();
            return;
        }

        // Comprueba las validaciones HTML.
        if (!formulario.checkValidity()) {
            evento.preventDefault();
            formulario.reportValidity();
            return;
        }

        // Comprueba las validaciones de jQuery, si están cargadas.
        if (window.jQuery && window.jQuery.validator &&
            !window.jQuery(formulario).valid()) {
            evento.preventDefault();
            return;
        }

        boton.disabled = true;
        boton.textContent = "Enviando...";
    });

    // Restablece el botón al volver con la navegación del navegador.
    window.addEventListener("pageshow", function() {
        boton.disabled = false;
        boton.textContent = "Registrar giro";
    });
</script>










