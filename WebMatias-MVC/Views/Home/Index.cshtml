@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="titulo-inicio">Bienvenido a mi espacio</h1>

    <p class="subtitulo-inicio">
        Tecnología, <span>proyectos</span>, experiencias y <span>viajes</span> en un solo lugar.
    </p>
    <br />
    <p class="frase-viajes">
        Otro planeta en este planeta,Donde el tiempo para,para estirar un poco las piernas.
    </p>
</div>



    <br />
    <br />
    <br />
    <br />

  
<div class="contenedor-imagenes">

    <!-- CAROUSEL VIAJES / TERMINAL -->
    <div id="carouselViajes"
         class="carousel slide carousel-matias"
         data-bs-ride="carousel"
         data-bs-interval="4000">

        <div class="carousel-inner">

            <!-- CHICA VIAJANDO -->
            <div class="carousel-item active">
                <img src="~/Imagenes/ChicaViajando.png"
                     class="imagen"
                     alt="Chica viajando" />
            </div>

            <!-- TERMINAL IA -->
            <div class="carousel-item">
                <img src="~/Imagenes/TerminalIA.png"
                     class="imagen"
                     alt="Terminal de ómnibus El Talar" />
            </div>

            <!-- TERMINAL IA 1 -->
            <div class="carousel-item">
                <img src="~/Imagenes/TerminalIA1.png"
                     class="imagen"
                     alt="Micros en Terminal de El Talar" />
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselViajes"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselViajes"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>


    <!-- CAROUSEL MATIAS -->
    <div id="carouselMatias"
         class="carousel slide carousel-matias"
         data-bs-ride="carousel"
         data-bs-interval="4000">

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="~/Imagenes/MatiasCpu.png"
                     class="imagen"
                     alt="Matías trabajando" />
            </div>

            <div class="carousel-item">
                <img src="~/Imagenes/Matias.png"
                     class="imagen"
                     alt="Matías" />
            </div>

            <div class="carousel-item">
                <img src="~/Imagenes/Matias1.png"
                     class="imagen"
                     alt="Matías" />
            </div>

            <div class="carousel-item">
                <img src="~/Imagenes/Matias2.png"
                     class="imagen"
                     alt="Matías" />
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselMatias"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselMatias"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>

</div>

<footer style="
    margin-top: 80px;
    padding: 30px;
    text-align: center;
    border-top: 1px solid #333;
    color: #A9B2BE;">

    <h5 style="color: #F2F2F2;">
        WebMatias MVC
    </h5>

    <p>
        Un espacio personal donde comparto mis proyectos,
        mi experiencia y contenido relacionado con viajes.
    </p>

    <p>
        Desarrollado por Matías Gómez con ASP.NET Core MVC, C# y SQL Server.
    </p>

    <small style="color: #777F89;">
        © 2026 Matías Gómez - Todos los derechos reservados.
    </small>

</footer>
