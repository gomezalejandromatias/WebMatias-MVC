<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  WebMatias (Otro Planeta En Este Planeta)</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebMatias_MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!--NAVBAR NUEVO -->
        <nav class="navbar navbar-expand-sm navbar-dark navbar-web mb-3">
            <div class="container-fluid">

                <!-- Marca -->
                <a class="navbar-brand marca-web"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="avion">✈</span>
                    WebMatias_<span>MVC</span>
                </a>

                <!-- Botón para celular -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="MostrarVistaSobremi">
                                Sobre mí
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Proyectos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Actualidad
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Viajes"
                               asp-action="MostrarVistaViajes">
                                <span class="avion-menu">✈</span> Viajes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Requisitos Para Viajar
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    






